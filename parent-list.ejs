<%- include('_head', { title: '我的打卡' }) %>
<%- include('_nav', { user, active: 'parent' }) %>

<% if (typeof flash !== 'undefined' && flash) { %><div class="flash"><%= flash %></div><% } %>

<h1 style="font-size:1.2rem; margin-bottom:14px;">我的21天旅程</h1>

<% if (commitments.length === 0) { %>
  <div class="card emptystate">
    <p>你還沒有開始任何一段21天聆聽旅程。</p>
  </div>
<% } else { %>
  <% commitments.forEach(function(c){ %>
    <a href="/parent/<%= c.id %>" style="text-decoration:none; color:inherit;">
      <div class="card">
        <div style="display:flex; align-items:center; justify-content:space-between;">
          <div>
            <div style="font-weight:700; margin-bottom:4px;"><%= c.child_name %></div>
            <div class="small muted"><%= c.relationship %></div>
          </div>
          <div class="pill<%= c.done_count >= 21 ? '' : '' %>"><%= c.done_count %> / 21 天</div>
        </div>
      </div>
    </a>
  <% }); %>
<% } %>

<a class="btn btn-accent" href="/parent/new">➕ 開始新的21天旅程</a>

<%- include('_foot') %>
