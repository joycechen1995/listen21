<div class="topnav">
  <div class="brand">21天親子聆聽挑戰<span class="eyebrow">每日打卡</span></div>
  <div class="navlinks">
    <% if (user) { %>
      <% if (user.role === 'parent') { %>
        <a href="/parent" class="<%= active === 'parent' ? 'active' : '' %>">我的打卡</a>
        <a href="/wall" class="<%= active === 'wall' ? 'active' : '' %>">夥伴動態牆</a>
      <% } else if (user.role === 'coach') { %>
        <a href="/coach" class="<%= active === 'coach' ? 'active' : '' %>">學員總覽</a>
        <a href="/wall" class="<%= active === 'wall' ? 'active' : '' %>">夥伴動態牆</a>
      <% } else if (user.role === 'admin') { %>
        <a href="/admin" class="<%= active === 'admin' ? 'active' : '' %>">後台管理</a>
      <% } %>
      <span class="small muted"><%= user.display_name %></span>
      <form method="post" action="/logout"><button class="linklike" type="submit">登出</button></form>
    <% } %>
  </div>
</div>
